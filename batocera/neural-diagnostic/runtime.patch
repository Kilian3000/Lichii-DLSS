+void DiagnosticTransition(vk::CommandBuffer commands, VkImage image, VkImageLayout before,
+                          VkImageLayout after) {
+    commands.PipelineBarrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, VkImageMemoryBarrier{
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = before == VK_IMAGE_LAYOUT_UNDEFINED ? 0u :
+                VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+            .oldLayout = before, .newLayout = after,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = image, .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}});
+}
+
+void DiagnosticBlit(vk::CommandBuffer commands, VkImage source, VkExtent2D source_extent,
+                    VkImage target, VkExtent2D target_extent) {
+    DiagnosticTransition(commands, source, VK_IMAGE_LAYOUT_GENERAL,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    DiagnosticTransition(commands, target, VK_IMAGE_LAYOUT_GENERAL,
+                         VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    const VkImageBlit region{
+        .srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .srcOffsets = {{0, 0, 0}, {static_cast<int32_t>(source_extent.width),
+                                  static_cast<int32_t>(source_extent.height), 1}},
+        .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .dstOffsets = {{0, 0, 0}, {static_cast<int32_t>(target_extent.width),
+                                  static_cast<int32_t>(target_extent.height), 1}}};
+    commands.BlitImage(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                      target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region, VK_FILTER_LINEAR);
+    DiagnosticTransition(commands, source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                         VK_IMAGE_LAYOUT_GENERAL);
+    DiagnosticTransition(commands, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                         VK_IMAGE_LAYOUT_GENERAL);
+}
