+void NvidiaDlssUpscaler::ResetNeuralRendering() {
+    // Every caller has drained the GPU and holds submit_mutex. Check sticky timeout
+    // counters here so FPS runs need no periodic queue drains. Do not throw at teardown.
+    if (NR::NeuralDiagnosticOptions().enabled && neural_rendering) {
+        try {
+            bool timeout = neural_rendering->HadTimeout();
+            for (const auto& pass : neural_extra_passes)
+                timeout = pass->HadTimeout() || timeout;
+            if (timeout) {
+                LOG_ERROR(Render_Vulkan, "NR DIAGNOSTIC FAILED final: completed={} frames "
+                          "passes={} kernel_timeout=true; discard this case",
+                          neural_diagnostic_frames, neural_extra_passes.size() + 1);
+                NR::ReportFailure("diagnostic neural rendering kernel timed out");
+            } else {
+                LOG_INFO(Render_Vulkan, "NR DIAGNOSTIC final: completed={} frames; "
+                         "all {} passes timeout-free; kernel_timeout=false",
+                         neural_diagnostic_frames, neural_extra_passes.size() + 1);
+            }
+        } catch (const std::exception& error) {
+            LOG_ERROR(Render_Vulkan, "NR DIAGNOSTIC FAILED final timeout check: {}", error.what());
+        }
+    }
+    neural_extra_passes.clear();
+    neural_rendering.reset();
+    neural_view = {};
+    neural_image = {};
+    neural_image_initialized = false;
+    neural_diagnostic_frames = 0;
+    neural_diagnostic_checks = 0;
+}
+
+void NvidiaDlssUpscaler::CreateDiagnosticImage(VkExtent2D extent) {
+    const auto features = device.GetPhysical().GetFormatProperties(
+        VK_FORMAT_R16G16B16A16_SFLOAT).optimalTilingFeatures;
+    constexpr VkFormatFeatureFlags required = VK_FORMAT_FEATURE_BLIT_SRC_BIT |
+        VK_FORMAT_FEATURE_BLIT_DST_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+    if ((features & required) != required)
+        throw std::runtime_error("RGBA16F linear blit unsupported");
+    neural_image = memory_allocator.CreateImage(VkImageCreateInfo{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .pNext = nullptr, .flags = 0,
+        .imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_R16G16B16A16_SFLOAT,
+        .extent = {extent.width, extent.height, 1}, .mipLevels = 1, .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                 VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE, .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr, .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED});
+    neural_view = device.GetLogical().CreateImageView(VkImageViewCreateInfo{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .pNext = nullptr, .flags = 0,
+        .image = *neural_image, .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format = VK_FORMAT_R16G16B16A16_SFLOAT, .components = {},
+        .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}});
 }
 
